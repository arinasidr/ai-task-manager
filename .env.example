ATM_API_PORT=8000
ATM_LOG_LEVEL=INFO
ATM_DATABASE_PATH=data/tasks.db
ATM_OLLAMA_BASE_URL=http://localhost:11434
ATM_ANALYST_MODEL=gemma4:e2b
ATM_PLANNER_MODEL=gemma4:e2b
ATM_TIMEZONE=Europe/Moscow
